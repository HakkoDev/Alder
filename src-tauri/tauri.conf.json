{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Alder",
    "version": "0.3.5",
    "identifier": "dev.hakkodev.alder",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist",
        "windows": {
            "staticVCRuntime": true
        }
    },
    "app": {
        "windows": [
            {
                "title": "Alder",
                "width": 1460,
                "height": 925,
                "minWidth": 960,
                "minHeight": 660,
                "label": "main",
                "resizable": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
    }
}
